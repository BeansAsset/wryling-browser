import("//brave/components/speedreader/common/buildflags/buildflags.gni")

source_set("split_view") {
  sources = [
    "brave_contents_container_view.cc",
    "brave_contents_container_view.h",
    "brave_multi_contents_view.cc",
    "brave_multi_contents_view.h",
    "brave_multi_contents_view_delegate_impl.cc",
    "brave_multi_contents_view_delegate_impl.h",
    "brave_multi_contents_view_mini_toolbar.cc",
    "brave_multi_contents_view_mini_toolbar.h",
    "wryling_split_controller.cc",
    "wryling_split_controller.h",
    "wryling_split_drop.h",
    "wryling_split_layout.cc",
    "wryling_split_layout.h",
  ]

  deps = [
    "//brave/browser/ui/sidebar",
    "//brave/browser/ui/tabs:tab_model",
    "//brave/browser/ui/views/frame",
    "//brave/components/vector_icons",
    "//chrome/browser/devtools",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:ui_features",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/color:mixers",
    "//chrome/browser/ui/exclusive_access",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/frame:contents_container_outline",
    "//chrome/browser/ui/views/frame:contents_web_view",
    "//chrome/browser/ui/views/frame:multi_contents_view_delegate",
    "//chrome/browser/ui/views/frame:scrim_view",
    "//components/split_tabs",
    "//components/tabs:public",
    "//ui/base/metadata",
    "//ui/compositor",
    "//ui/views",
  ]

  if (is_mac) {
    # Test-only drag replay (WRYLING_TEST_DRAG).
    sources += [ "wryling_split_test_drag_mac.mm" ]
    frameworks = [ "Cocoa.framework" ]
  }

  if (enable_speedreader) {
    deps += [ "//brave/browser/ui/views/speedreader" ]
  }
}
