import("//mojo/public/tools/bindings/mojom.gni")

# The per-space New Tab dashboard's API (Wryling Spaces). The browser side is
# in //brave/browser/ui/spaces, the page in brave_new_tab_page_refresh.
mojom("mojom") {
  sources = [ "wryling_dashboard.mojom" ]
}

source_set("binder") {
  sources = [
    "wryling_dashboard_binder.cc",
    "wryling_dashboard_binder.h",
  ]
  public_deps = [
    ":mojom",
    "//mojo/public/cpp/bindings",
  ]
}
