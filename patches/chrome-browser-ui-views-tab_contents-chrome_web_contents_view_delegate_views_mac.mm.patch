+// Preserve the Mac model's text services while rendering its rows in Views.
+class WrylingMacMenuDelegate : public ToolkitDelegateViews {
+ public:
+  explicit WrylingMacMenuDelegate(RenderViewContextMenuMac* menu) : menu_(menu) {}
+
+  void Init(ui::SimpleMenuModel* model) override {
+    menu_->InitToolkitMenu();
+    ToolkitDelegateViews::Init(model);
+  }
+
+  void UpdateMenuItem(int command_id,
+                      bool enabled,
+                      bool hidden,
+                      const std::u16string& title) override {
+    if (auto* item = menu_view()->GetMenuItemByID(command_id)) {
+      item->SetTitle(title);
+      item->SetEnabled(enabled);
+      item->SetVisible(!hidden);
+      menu_view()->ChildrenChanged();
+    }
+  }
+
+ private:
+  raw_ptr<RenderViewContextMenuMac> menu_;
+};
+
+class WrylingMacContextMenu : public RenderViewContextMenuMac {
+ public:
+  WrylingMacContextMenu(content::RenderFrameHost& frame,
+                       const content::ContextMenuParams& params,
+                       bool paste_enabled,
+                       bool paste_and_match_style_enabled)
+      : RenderViewContextMenuMac(frame, params, paste_enabled,
+                                 paste_and_match_style_enabled) {
+    set_toolkit_delegate(std::make_unique<WrylingMacMenuDelegate>(this));
+  }
+
+  void Show() override {
+    auto* widget = views::Widget::GetTopLevelWidgetForNativeView(
+        source_web_contents_->GetNativeView());
+    if (!widget || headless::IsHeadlessMode() ||
+        menu_model_.GetItemCount() == 0) {
+      return;
+    }
+    gfx::Point point = source_web_contents_->GetContainerBounds().origin();
+    point.Offset(params_.x, params_.y);
+    base::CurrentThread::ScopedAllowApplicationTasksInNativeNestedLoop allow;
+    static_cast<ToolkitDelegateViews*>(toolkit_delegate())
+        ->RunMenuAt(widget, point, params_.source_type);
+  }
+
+  bool GetAcceleratorForCommandId(int command_id,
+                                  ui::Accelerator* accelerator) const override {
+    return GetDefaultMacAcceleratorForCommandId(command_id, accelerator);
+  }
+};
+
+}  // namespace
