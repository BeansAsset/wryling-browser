+#if BUILDFLAG(IS_MAC)
+// Wryling: real Liquid Glass behind bubbles shown over a Wryling window,
+// matching its sidebar (the shape is the bubble's rounded contents rect,
+// inside the border's shadow insets). When glass comes or goes, the client
+// view's solid fill is recomputed via SetBackgroundColor().
+void UpdateWrylingGlassForBubble(BubbleFrameView* frame) {
+  Widget* const widget = frame->GetWidget();
+  if (!widget || !frame->bubble_border()) {
+    return;
+  }
+  const bool had_glass = widget->GetProperty(kWrylingPopupGlassKey);
+  const bool has_glass = UpdateWrylingPopupGlass(
+      widget, frame->ConvertRectToWidget(frame->GetContentsBounds()),
+      frame->bubble_border()->rounded_corners().upper_left());
+  if (had_glass != has_glass) {
+    frame->SetBackgroundColor(frame->background_color());
+  }
+}
+#endif
+
 constexpr int kMainImageBorderStrokeThickness = 1;
 
