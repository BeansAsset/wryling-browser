+    // Add margins for spacing for flex layout. Wryling: after the buttons the
+    // link keeps a gap from them even when the bar is too narrow for the
+    // spacers between them (e.g. beside the sidebar).
+    const int leading_margin =
+        GetDelegate()->ShouldShowLinkBeforeButton()
+            ? 0
+            : ChromeLayoutProvider::Get()->GetDistanceMetric(
+                  views::DISTANCE_UNRELATED_CONTROL_HORIZONTAL);
+    link_->SetProperty(views::kMarginsKey,
+                       std::make_unique<gfx::Insets>(
+                           gfx::Insets::TLBR(0, leading_margin, 0, 0)));
