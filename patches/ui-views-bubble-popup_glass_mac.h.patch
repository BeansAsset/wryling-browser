+#ifndef UI_VIEWS_BUBBLE_POPUP_GLASS_MAC_H_
+#define UI_VIEWS_BUBBLE_POPUP_GLASS_MAC_H_
+
+#include "ui/base/class_property.h"
+#include "ui/views/views_export.h"
+
+namespace gfx {
+class Rect;
+}
+
+namespace views {
+class View;
+class Widget;
+
+// Set on a popup widget while Wryling's glass is behind it, so its views skip
+// their solid backgrounds.
+VIEWS_EXPORT extern const ui::ClassProperty<bool>* const kWrylingPopupGlassKey;
+
+// Wryling (macOS 26): puts real Liquid Glass behind a translucent popup
+// widget (bubbles, the address bar dropdown) whose parent window has
+// Wryling's glass sidebar, tinted exactly like that sidebar. |bounds| is the
+// popup's visible shape in widget coordinates. Returns false, and removes
+// any glass it added before, when glass can't be used: older macOS, Reduce
+// Transparency, or a parent that isn't a Wryling browser window. The caller
+// then paints its usual solid background.
+// |tint_scale| scales the sidebar tint's strength (1 = identical; lower for a
+// clearer, Spotlight-like glass).
+VIEWS_EXPORT bool UpdateWrylingPopupGlass(Widget* popup,
+                                          const gfx::Rect& bounds,
+                                          float corner_radius,
+                                          float tint_scale = 1.0f);
+
+// Makes |view|'s subtree draw correctly over glass: layers that don't fill
+// their bounds opaquely, and no subpixel text (it needs an opaque backdrop).
+VIEWS_EXPORT void PrepareViewsForWrylingGlass(View* view);
+
+}  // namespace views
+
+#endif  // UI_VIEWS_BUBBLE_POPUP_GLASS_MAC_H_
